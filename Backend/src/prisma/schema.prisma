generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  mail       String  @id @db.VarChar(255)
  contrasena String  @map("contraseña") @db.VarChar(255)
  persona    Persona?
  sesiones   Sesion[]
  perfiles   UsuarioPerfil[]
  passwordReset PasswordReset?

  @@map("USUARIO")
}

model Persona {
  dni      String  @id @db.VarChar(32)
  mail     String  @unique @db.VarChar(255)
  usuario  Usuario @relation(fields: [mail], references: [mail])
  nombre   String? @db.VarChar(120)
  apellido String? @db.VarChar(120)
  telefono String? @db.VarChar(40)

  @@map("PERSONA")
}

model Sesion {
  email           String    @db.VarChar(255)
  usuario         Usuario   @relation(fields: [email], references: [mail])
  fechaHoraInicio DateTime
  fechaHoraFin    DateTime?

  @@id([email, fechaHoraInicio])
  @@index([email])
  @@map("SESION")
}

model Perfil {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(120)
  descripcion String?  @db.VarChar(255)
  usuarios    UsuarioPerfil[]

  @@map("PERFIL")
}

model UsuarioPerfil {
  mail     String
  idPerfil Int
  usuario  Usuario @relation(fields: [mail], references: [mail])
  perfil   Perfil  @relation(fields: [idPerfil], references: [id])

  // Relaciones de Pedidos (Archivo 2)
  pedidosCreados  Pedido[] @relation("Pedido_Creador")
  pedidosCocinero Pedido[] @relation("Pedido_Cocinero")

  @@id([mail, idPerfil])
  @@index([idPerfil])
  @@index([mail])
  @@map("USUARIOxPERFIL")
}

model PasswordReset {
  mail      String   @id
  usuario   Usuario  @relation(fields: [mail], references: [mail])
  tokenHash String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("PASSWORD_RESET")
}

model Insumo {
  id                   Int             @id @default(autoincrement())
  nombre               String          @unique
  cal_100g             Float
  grasasTotales_100g   Float
  grasasTrans_100g     Float
  grasasSaturadas_100g Float
  proteinas_100g       Float
  carbohidratos_100g   Float
  sodio_100g           Float
  fibra_100g           Float
  otro_100g            Float
  activo               Boolean         @default(true)
  formulaInsumos       FormulaInsumo[]

  @@map("INSUMOS")
}

model Formula {
  id             Int             @id @default(autoincrement())
  nombre         String          @unique
  porcion        Float
  kcalorias      Float
  kjuls          Float
  grasaTotal     Float
  grasaTrans     Float
  grasaSaturada  Float
  proteinas      Float
  carbohidratos  Float
  sodio          Float
  fibra          Float
  otros          Float
  esProtegida    Boolean
  activo         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  formulaInsumos FormulaInsumo[]
  Producto       Producto[]

  @@index([nombre, activo])
  @@map("FORMULA")
}

model FormulaInsumo {
  id             Int     @id @default(autoincrement())
  idFormula      Int
  idInsumo       Int
  cantidadInsumo Float
  formula        Formula @relation(fields: [idFormula], references: [id])
  insumo         Insumo  @relation(fields: [idInsumo], references: [id])

  @@map("FORMULAINSUMO")
}

model Tipos_Movimiento {
  idTipoMovimiento Int                   @id @default(autoincrement())
  nombre           String                @db.VarChar(120) @unique
  movimientos      Movimiento_Producto[]

  @@map("TIPOS_MOVIMIENTO")
}

model Movimiento_Producto {
  idMovimiento           Int       @id @default(autoincrement())
  fechaHoraActualizacion DateTime  @default(now())
  idDepositoOrigen       Int
  idProducto             Int
  idDepositoDestino      Int?
  cantidad               Int
  responsable            String    @db.VarChar(255)
  observaciones          String?   @db.Text
  idTipoMovimiento       Int
  inventarioOrigen       Inventario @relation("MovimientosOrigen", fields: [idDepositoOrigen, idProducto], references: [idDeposito, idProducto])
  inventarioDestino      Inventario? @relation("MovimientosDestino", fields: [idDepositoDestino, idProducto], references: [idDeposito, idProducto])
  tipoMovimiento         Tipos_Movimiento @relation(fields: [idTipoMovimiento], references: [idTipoMovimiento])
  cambiosDeEstado        Cambio_Estado_Movimiento[]

  @@index([idDepositoOrigen, idProducto])
  @@index([idDepositoDestino, idProducto])
  @@index([idTipoMovimiento])
  @@map("MOVIMIENTO_PRODUCTO")
}

model Estado_Movimiento {
  idEstadoMovimiento Int                          @id @default(autoincrement())
  nombre             String                       @db.VarChar(120) @unique
  cambios            Cambio_Estado_Movimiento[] @relation("estado_cambios")

  @@map("ESTADO_MOVIMIENTO")
}

model Cambio_Estado_Movimiento {
  idCambioEstadoMovimiento Int               @id @default(autoincrement())
  idEstadoMovimiento       Int
  fechaHoraInicio          DateTime
  fechaHoraFin             DateTime?
  responsable              String?           @db.VarChar(255)
  responsableEntrega       String?           @db.VarChar(255)
  responsableRecepcion     String?           @db.VarChar(255)
  observaciones            String?           @db.Text
  estadoMovimiento         Estado_Movimiento @relation("estado_cambios", fields: [idEstadoMovimiento], references: [idEstadoMovimiento])
  idMovimiento             Int
  movimiento               Movimiento_Producto @relation(fields: [idMovimiento], references: [idMovimiento])

  @@index([idEstadoMovimiento])
  @@index([idMovimiento])
  @@map("CAMBIO_ESTADO_MOVIMIENTO")
}

model Deposito {
  id             Int          @id @default(autoincrement())
  nombre         String       @unique
  direccion      String
  responsable    String
  capacidadTotal Int
  capacidadUsada Int          @default(0)
  estado         Boolean      @default(true)
  esProtegido    Boolean      @default(false)
  inventario     Inventario[]

  @@map("DEPOSITOS")
}

model Producto {
  idProducto             Int          @id @default(autoincrement())
  idFormula              Int
  nombreComercial        String       @unique
  pesoNeto               Float
  cantPorcionesAportadas Int
  estaActivo             Boolean      @default(true)
  lastStockUpdatedAt     DateTime     @default(now())
  formula                Formula      @relation(fields: [idFormula], references: [id])
  inventario             Inventario[]
  pedidos                Pedido[]     

  @@index([nombreComercial, estaActivo])
  @@map("PRODUCTOS")
}

model Inventario {
  idDeposito Int
  idProducto Int
  deposito   Deposito @relation(fields: [idDeposito], references: [id], onUpdate: Cascade, onDelete: Restrict)
  producto   Producto @relation(fields: [idProducto], references: [idProducto], onUpdate: Cascade, onDelete: Restrict)
  cantidadProducto     Int      @default(0)
  umbralMin            Int      @default(0)
  umbralMax            Int?
  updatedAt            DateTime @default(now()) @updatedAt

  // Relaciones de Movimientos (Archivo 1)
  movimientosComoOrigen  Movimiento_Producto[] @relation("MovimientosOrigen")
  movimientosComoDestino Movimiento_Producto[] @relation("MovimientosDestino")

  @@id([idDeposito, idProducto])
  @@index([idDeposito])
  @@index([idProducto])
  @@map("INVENTARIO")
}

model EstadoPedido {
  id      Int                  @id @default(autoincrement())
  nombre  String               @unique
  cambios CambioEstadoPedido[]

  @@index([nombre])
  @@map("ESTADO_PEDIDO")
}

model CambioEstadoPedido {
  idCambioEstado   Int          @id @default(autoincrement())
  idPedido         Int
  idEstadoPedido   Int
  fechaHoraInicio  DateTime
  fechaHoraFin     DateTime?
  pedido           Pedido       @relation("Pedido_Historial", fields: [idPedido], references: [numPedido])
  pedidoActualDe   Pedido?      @relation("Pedido_CambioActual")
  estado           EstadoPedido @relation(fields: [idEstadoPedido], references: [id])

  @@index([idPedido])
  @@index([idEstadoPedido])
  @@map("CAMBIO_ESTADO_PEDIDO")
}

model Pedido {
  numPedido                Int                   @id @default(autoincrement())
  idProducto               Int
  cantAProducir_gramos     Float
  cantAProducir_paquetes   Float
  cantAProducir_porciones  Float
  observacion              String?
  idCambioEstadoPedido     Int?                  @unique
  mailUsuarioCreador       String
  idPerfilCreador          Int
  mailUsuarioCocinero      String?
  idPerfilCocinero         Int?
  estaAsignado             Boolean               @default(false)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  producto                 Producto              @relation(fields: [idProducto], references: [idProducto])
  cambioActual             CambioEstadoPedido?   @relation("Pedido_CambioActual", fields: [idCambioEstadoPedido], references: [idCambioEstado])
  cambios                  CambioEstadoPedido[]  @relation("Pedido_Historial")
  creador                  UsuarioPerfil         @relation("Pedido_Creador", fields: [mailUsuarioCreador, idPerfilCreador], references: [mail, idPerfil])
  cocinero                 UsuarioPerfil?        @relation("Pedido_Cocinero", fields: [mailUsuarioCocinero, idPerfilCocinero], references: [mail, idPerfil])

  @@index([estaAsignado, createdAt])
  @@index([idProducto])
  @@index([mailUsuarioCreador, idPerfilCreador])
  @@index([mailUsuarioCocinero, idPerfilCocinero])
  @@map("PEDIDOS")
}